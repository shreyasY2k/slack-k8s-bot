{
  "name": "slack-k8s-bot",
  "version": "1.0.0",
  "type": "module",
  "description": "AI-powered Kubernetes alert diagnosis and remediation bot using MCP",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "mcp:dev": "tsx src/mcp-standalone.ts",
    "test": "jest",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write 'src/**/*.ts'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.27.0",
    "@google/generative-ai": "^0.19.0",
    "@kubernetes/client-node": "^0.21.0",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@slack/web-api": "^7.0.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "openai": "^4.67.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/express": "^4.17.23",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "kubernetes",
    "slack",
    "alerting",
    "mcp",
    "ai",
    "devops"
  ],
  "author": "",
  "license": "MIT"
}
